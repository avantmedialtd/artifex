{
    "name": "@avantmedia/af",
    "version": "0.2.1",
    "description": "Development utility.",
    "homepage": "https://github.com/avantmedialtd/artifex#readme",
    "bugs": {
        "url": "https://github.com/avantmedialtd/artifex/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/avantmedialtd/artifex.git"
    },
    "license": "MIT",
    "author": "István Antal <istvan@antal.xyz>",
    "keywords": [
        "cli",
        "developer-tools",
        "bun",
        "openspec",
        "dependency-upgrade"
    ],
    "bin": {
        "af": "./af"
    },
    "engines": {
        "node": ">=16"
    },
    "type": "module",
    "files": [
        "af",
        "main.ts",
        "router.ts",
        "bun-upgrade.ts",
        "npm-upgrade.ts",
        "git-worktree.ts",
        "commands/",
        "components/",
        "utils/",
        "resources/",
        "scripts/e2e_tests.ts",
        "atlassian/**/*.ts",
        "jira/**/*.ts",
        "confluence/**/*.ts",
        "bitbucket/**/*.ts",
        "sonar/**/*.ts",
        "!**/*.test.ts"
    ],
    "main": "main.ts",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "lint:check": "oxlint .",
        "spell:check": "cspell \"**\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "bump": "bun run scripts/bump-version.ts",
        "prepublishOnly": "node -e \"if(!process.env.CI) throw new Error('Publish via CI only — use /release')\""
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@vitest/ui": "^4.1.11",
        "cspell": "^10.1.1",
        "oxlint": "^1.80.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "react-devtools-core": "^7.0.1",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "bun": ">=1.1.0",
        "chalk": "^6.0.0",
        "ink": "^7.1.1",
        "react": "^19.2.8"
    }
}
